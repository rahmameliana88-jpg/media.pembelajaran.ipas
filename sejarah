      <text x="40" y="95" font-size="10" fill="var(--mut)">← Banten</text>
      <g id="pins"></g>
    </svg>
    <div id="petainfo" class="box mut">Pilih salah satu titik pada peta.</div>
  </section>
</div>

<div class="v" id="galeri">
  <section>
    <h2>🖼️ Galeri Pahlawan</h2>
    <p class="mut">Sentuh kartu untuk melihat data lengkap tokoh.</p>
    <div class="grid" id="kartu"></div>
  </section>
  <section id="detail" style="display:none"></section>
</div>

<div class="v" id="kisah">
  <section>
    <h2>📖 Kisah Perjuangan</h2>
    <div class="tabs" id="ktabs"></div>
    <div id="kisi"></div>
  </section>
</div>

<div class="v" id="misi">
  <section>
    <h2>🕵️ Misi 1: Siapa Aku?</h2>
    <div id="siapa"></div>
  </section>
  <section>
    <h2>🧩 Misi 2: Cocokkan Bentuk Perjuangan</h2>
    <div id="cocok"></div>
    <button onclick="cekCocok()">Periksa Jawaban</button>
    <p class="fb" id="cocokfb"></p>
  </section>
  <section>
    <h2>📍 Misi 3: Asal Daerah Pahlawanku</h2>
    <p class="mut">Seret nama pahlawan ke titik daerah asalnya di peta.</p>
    <div id="asal"></div>
  </section>
</div>

<div class="v" id="kuis">
  <section>
    <h2>🏆 Kuis Pahlawan</h2>
    <div id="soal"></div>
    <p>Skor: <span class="sk" id="skor">0</span> / <span class="sk" id="total">0</span></p>
  </section>
</div>

<div class="v" id="refleksi">
  <section>
    <h2>💭 Refleksi Diriku</h2>
    <p>Setiap pahlawan memberi contoh sikap baik. Ayo hubungkan dengan kehidupanmu!</p>
    <p><b>1. Di sekolah:</b> Sikap pahlawan apa yang bisa aku tiru di sekolah?</p><textarea aria-label="Refleksi sekolah"></textarea>
